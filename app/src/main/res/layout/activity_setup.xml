<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bento_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Header Row (Logo + Brand + Badge) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_bento_white"
                android:padding="3dp"
                android:src="@drawable/app_logo"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="ONE KEYBOARD"
                    android:textColor="@color/bento_blue"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Panduan Setup Cepat"
                    android:textColor="@color/bento_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Step Progress Badge -->
            <TextView
                android:id="@+id/tvSetupProgressBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bento_pill_blue"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="0 / 3 Selesai"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Big Title & Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-black"
            android:text="Aktivasi Keyboard"
            android:textColor="@color/bento_text_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:text="Selesaikan 3 langkah di bawah agar keyboard dan pemindai barcode siap digunakan mengetik di aplikasi manapun."
            android:textColor="@color/bento_text_secondary"
            android:textSize="13sp" />

        <!-- ==================== STEP 1 CARD: ENABLE IN SETTINGS ==================== -->
        <LinearLayout
            android:id="@+id/cardStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_setup_card_active"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp">

                    <ImageView
                        android:id="@+id/ivStep1NumberBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_step_circle_blue"
                        android:contentDescription="Step 1" />

                    <TextView
                        android:id="@+id/tvStep1Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Aktifkan di Pengaturan"
                        android:textColor="@color/bento_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="Nyalakan sakelar 'One Keyboard' di daftar masukan sistem."
                        android:textColor="@color/bento_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/tvStep1StatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bento_pill_cream"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="Belum"
                    android:textColor="@color/bento_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Action Button -->
            <Button
                android:id="@+id/btnStep1Enable"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_blue"
                android:fontFamily="sans-serif-black"
                android:text="1. Buka Pengaturan Keyboard"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ==================== STEP 2 CARD: SELECT DEFAULT ==================== -->
        <LinearLayout
            android:id="@+id/cardStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_bento_white"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp">

                    <ImageView
                        android:id="@+id/ivStep2NumberBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_step_circle_muted"
                        android:contentDescription="Step 2" />

                    <TextView
                        android:id="@+id/tvStep2Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:text="2"
                        android:textColor="@color/bento_text_secondary"
                        android:textSize="15sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Pilih One Keyboard"
                        android:textColor="@color/bento_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="Jadikan sebagai keyboard utama untuk mulai mengetik."
                        android:textColor="@color/bento_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/tvStep2StatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bento_pill_cream"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="Belum"
                    android:textColor="@color/bento_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Action Button -->
            <Button
                android:id="@+id/btnStep2Select"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_blue"
                android:fontFamily="sans-serif-black"
                android:text="2. Pilih One Keyboard"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ==================== STEP 3 CARD: CAMERA PERMISSION ==================== -->
        <LinearLayout
            android:id="@+id/cardStep3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_bento_white"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp">

                    <ImageView
                        android:id="@+id/ivStep3NumberBg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/bg_step_circle_muted"
                        android:contentDescription="Step 3" />

                    <TextView
                        android:id="@+id/tvStep3Number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:text="3"
                        android:textColor="@color/bento_text_secondary"
                        android:textSize="15sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Izin Kamera Pemindai"
                        android:textColor="@color/bento_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:text="Dibutuhkan tombol biru untuk scan barcode &amp; QR code."
                        android:textColor="@color/bento_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/tvStep3StatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bento_pill_cream"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="Belum"
                    android:textColor="@color/bento_text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Action Button -->
            <Button
                android:id="@+id/btnStep3Camera"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_blue"
                android:fontFamily="sans-serif-black"
                android:text="3. Izinkan Akses Kamera"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Success Banner (Appears when all steps completed) -->
        <LinearLayout
            android:id="@+id/layoutAllDoneBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_bento_pill_blue"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_circle"
                android:contentDescription="Selesai" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-black"
                android:text="Setup Selesai! Semua fitur siap digunakan."
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Primary CTA: Mulai Gunakan Keyboard -->
        <Button
            android:id="@+id/btnFinishSetup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_button_blue"
            android:fontFamily="sans-serif-black"
            android:text="Mulai Gunakan Keyboard"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Skip to Dashboard Link -->
        <TextView
            android:id="@+id/tvSkipSetup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-medium"
            android:padding="8dp"
            android:text="Lewati ke Dashboard"
            android:textColor="@color/bento_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
