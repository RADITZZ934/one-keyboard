<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_clipboard_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Clipboard text content preview -->
    <TextView
        android:id="@+id/tvClipContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp"
        tools:text="Contoh teks yang baru saja disalin dari papan klip..." />

    <!-- Bottom info and action row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvClipTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            tools:text="2 mnt lalu" />

        <!-- Pin Button -->
        <ImageButton
            android:id="@+id/btnPinClip"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sematkan"
            android:padding="6dp"
            android:src="@drawable/ic_pin_outline"
            app:tint="@color/heliboard_accent" />

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/btnDeleteClip"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hapus"
            android:padding="6dp"
            android:src="@drawable/ic_delete"
            app:tint="?android:attr/textColorSecondary" />

    </LinearLayout>

</LinearLayout>
