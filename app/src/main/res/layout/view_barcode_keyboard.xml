<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboardOuterFrame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/keyboardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/heliboard_surface"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

    <!-- 1. Lazy Camera Scanner Viewfinder (Inflated on demand via ViewStub) -->
    <ViewStub
        android:id="@+id/scannerViewStub"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:inflatedId="@+id/scannerContainer"
        android:layout="@layout/layout_scanner_viewfinder" />


    <!-- 2. Bento Toolbar (7 Action Buttons as in PixelBoard / Gboard Image 1) -->
    <LinearLayout
        android:id="@+id/toolbarContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/heliboard_toolbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- 1. Scanner Trigger Pill Button -->
        <LinearLayout
            android:id="@+id/btnToggleScanner"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_scan_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/ivScanIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_scan"
                app:tint="#CAD1DC" />

            <TextView
                android:id="@+id/tvScanLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Scan"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Flashlight Button (visible when scanner active) -->
        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_bento_toolbar_pill"
            android:contentDescription="Flashlight"
            android:padding="7dp"
            android:src="@drawable/ic_flash"
            android:visibility="gone"
            app:tint="@color/heliboard_text" />

        <!-- 2. Papan Klip Button -->
        <ImageButton
            android:id="@+id/btnClipboard"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_bento_toolbar_pill"
            android:contentDescription="Papan Klip"
            android:padding="7dp"
            android:src="@drawable/ic_clipboard"
            app:tint="@color/heliboard_text" />


        <!-- 4. GIF Button -->
        <ImageButton
            android:id="@+id/btnGif"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_bento_toolbar_pill"
            android:contentDescription="GIF"
            android:padding="6dp"
            android:src="@drawable/ic_gif"
            app:tint="@color/heliboard_text" />

        <!-- 5. Cursor Navigation (< and >) -->
        <ImageButton
            android:id="@+id/btnCursorLeft"
            android:layout_width="28dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_bento_toolbar_pill"
            android:contentDescription="Cursor Left"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/heliboard_text" />

        <ImageButton
            android:id="@+id/btnCursorRight"
            android:layout_width="28dp"
            android:layout_height="34dp"
            android:layout_marginStart="1dp"
            android:background="@drawable/bg_bento_toolbar_pill"
            android:contentDescription="Cursor Right"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/heliboard_text" />

        <!-- Spacer to push right group to the end -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 6. Tombol 4 Kotak (Fitur Lanjutan) -->
        <ImageButton
            android:id="@+id/btnToggleTools"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_bento_toolbar_pill"
            android:contentDescription="Fitur Lanjutan"
            android:padding="7dp"
            android:src="@drawable/ic_bento_grid"
            app:tint="@color/heliboard_text" />

        <!-- 7. AI Voice Assistant -->
        <ImageButton
            android:id="@+id/btnAiVoice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_bento_toolbar_pill"
            android:contentDescription="AI Voice Assistant"
            android:padding="6dp"
            android:src="@drawable/ic_ai_mic"
            app:tint="@color/heliboard_text" />

    </LinearLayout>

    <!-- AI Voice Assistant Listening Bar (Material 3 Gemini Pulse) -->
    <LinearLayout
        android:id="@+id/aiVoiceContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/heliboard_toolbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivAiVoiceWave"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_ai_mic"
            app:tint="#A8C7FA" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAiVoiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mendengarkan... Silakan bicara"
                android:textColor="#A8C7FA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiVoiceLiveText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Katakan teks yang ingin diketik..."
                android:textColor="@color/heliboard_text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAiVoiceStop"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Selesai"
            android:textColor="#A8C7FA"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnAiVoiceClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_toolbar_item"
            android:contentDescription="Batal"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/heliboard_text_sub" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/heliboard_divider" />

    <!-- 4. Fitur Lanjutan (2-Column Feature Cards Drawer Image 2) -->
    <LinearLayout
        android:id="@+id/toolsDrawerContainer"
        android:layout_width="match_parent"
        android:layout_height="225dp"
        android:background="@color/heliboard_surface"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <ImageButton
                android:id="@+id/btnDrawerClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_toolbar_item"
                android:contentDescription="Tutup Fitur"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                app:tint="@color/heliboard_text" />

            <TextView
                android:id="@+id/tvDrawerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Fitur Lanjutan"
                android:textColor="@color/heliboard_text"
                android:textSize="14sp"
                android:textStyle="bold" />


            <ImageButton
                android:id="@+id/btnDrawerShortcutGif"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_bento_toolbar_pill"
                android:contentDescription="GIF"
                android:padding="6dp"
                android:src="@drawable/ic_gif"
                app:tint="@color/heliboard_text_sub" />

            <ImageButton
                android:id="@+id/btnDrawerShortcutClipboard"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_bento_toolbar_pill"
                android:contentDescription="Papan Klip"
                android:padding="7dp"
                android:src="@drawable/ic_clipboard"
                app:tint="@color/heliboard_text_sub" />

            <ImageButton
                android:id="@+id/btnDrawerShortcutSettings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_bento_toolbar_pill"
                android:contentDescription="Pengaturan"
                android:padding="7dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/heliboard_text_sub" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/heliboard_divider" />

        <!-- 2-Column Feature Cards Grid ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Row 1: Scan Barcode & Papan Klip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnCardScanner"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_feature_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_scan"
                            app:tint="@color/heliboard_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Scan Barcode"
                            android:textColor="@color/heliboard_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCardClipboard"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_feature_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_clipboard"
                            app:tint="@color/heliboard_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Papan Klip"
                            android:textColor="@color/heliboard_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Pengeditan Teks & Ubah Ukuran -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnCardTextEdit"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_feature_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_keyboard"
                            app:tint="@color/heliboard_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Pengeditan teks"
                            android:textColor="@color/heliboard_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCardScale"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_feature_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_reset"
                            app:tint="@color/heliboard_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Ubah ukuran"
                            android:textColor="@color/heliboard_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3: Tema Keyboard & Pengaturan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnCardTheme"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_feature_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_theme"
                            app:tint="@color/heliboard_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Tema Keyboard"
                            android:textColor="@color/heliboard_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCardSettings"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_feature_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_settings"
                            app:tint="@color/heliboard_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Pengaturan"
                            android:textColor="@color/heliboard_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 4: Zoom Kamera & Suara/Getar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnCardZoom"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_feature_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/heliboard_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Zoom Kamera"
                            android:textColor="@color/heliboard_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCardFeedback"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_feature_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/heliboard_accent" />

                        <TextView
                            android:id="@+id/tvCardFeedback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Suara &amp; Getar"
                            android:textColor="@color/heliboard_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/heliboard_divider" />

    <!-- 3. HeliBoard Essential Keyboard Keypad Area -->
    <LinearLayout
        android:id="@+id/keypadContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="3dp"
        android:paddingTop="5dp"
        android:paddingEnd="3dp"
        android:paddingBottom="6dp">

        <!-- Number Row (1 - 0) -->
        <LinearLayout
            android:id="@+id/rowNumber"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:visibility="visible" />

        <!-- Row 1 -->
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <!-- Row 2 -->
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <!-- Row 3 -->
        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <!-- Row 4 -->
        <LinearLayout
            android:id="@+id/row4"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

    </LinearLayout>

    <!-- 4. Clipboard History Panel (Papan Klip) -->
    <LinearLayout
        android:id="@+id/clipboardContainer"
        android:layout_width="match_parent"
        android:layout_height="225dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_clipboard"
                app:tint="@color/heliboard_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Papan Klip"
                android:textColor="@color/heliboard_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClipboardCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:textColor="@color/heliboard_text_sub"
                android:textSize="12sp"
                android:text="(0)" />

            <Button
                android:id="@+id/btnClearClipboard"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Bersihkan"
                android:textColor="#FF5252"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnCloseClipboard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_toolbar_item"
                android:contentDescription="Tutup Papan Klip"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                app:tint="@color/heliboard_text" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/heliboard_divider" />

        <!-- Recycler View List of Clips -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvClipboardItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:scrollbars="vertical" />

        <!-- Empty State Notice -->
        <TextView
            android:id="@+id/tvClipboardEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="20dp"
            android:text="Papan klip kosong.\nTeks yang Anda salin (copy) akan otomatis muncul di sini."
            android:textAlignment="center"
            android:textColor="@color/heliboard_text_sub"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>


    <!-- 6. GIF & Reaksi Cepat Panel -->
    <!-- 6. GIF Tenor Panel -->
    <LinearLayout
        android:id="@+id/gifContainer"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@color/heliboard_surface"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Search & Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnCloseGif"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_bento_toolbar_pill"
                android:contentDescription="Tutup GIF"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                app:tint="@color/heliboard_text" />

            <!-- Search Input Box -->
            <LinearLayout
                android:id="@+id/llGifSearchBox"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_bento_pill_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/ivGifSearchIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/heliboard_text_sub" />

                <EditText
                    android:id="@+id/etGifSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Cari GIF di Tenor..."
                    android:imeOptions="actionSearch"
                    android:inputType="textNoSuggestions"
                    android:singleLine="true"
                    android:textColor="@color/heliboard_text"
                    android:textColorHint="@color/heliboard_text_sub"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnClearGifSearch"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Hapus pencarian"
                    android:padding="4dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/heliboard_text_sub" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivTenorBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_gif"
                app:tint="@color/heliboard_accent" />
        </LinearLayout>

        <View
            android:id="@+id/dividerGif"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/heliboard_divider" />

        <!-- Status / Loading / Content Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- RecyclerView for Tenor GIFs -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGifList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="3dp"
                android:scrollbars="vertical" />

            <!-- Loading Spinner -->
            <ProgressBar
                android:id="@+id/pbGifLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty / Error State Layout -->
            <LinearLayout
                android:id="@+id/llGifEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvGifEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tidak ada GIF ditemukan"
                    android:textColor="@color/heliboard_text_sub"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnGifRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_bento_toolbar_pill"
                    android:text="Coba Lagi"
                    android:textColor="@color/heliboard_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Sending Overlay Feedback -->
            <LinearLayout
                android:id="@+id/llGifSendingOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#80000000"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

                <TextView
                    android:id="@+id/tvGifSendingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Mengirim GIF..."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 7. Pengeditan Teks D-Pad Panel -->
    <LinearLayout
        android:id="@+id/textEditContainer"
        android:layout_width="match_parent"
        android:layout_height="225dp"
        android:background="@color/heliboard_surface"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_keyboard"
                app:tint="@color/heliboard_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Pengeditan Teks"
                android:textColor="@color/heliboard_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseTextEdit"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_toolbar_item"
                android:contentDescription="Tutup Pengeditan Teks"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                app:tint="@color/heliboard_text" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/heliboard_divider" />

        <!-- D-Pad and Action Buttons Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Action buttons (Select All, Copy, Paste) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnTextSelectAll"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_bento_pill_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Pilih Semua"
                    android:textColor="@color/heliboard_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnTextCopy"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_bento_pill_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Salin"
                    android:textColor="@color/heliboard_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnTextPaste"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_bento_pill_dark"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Tempel"
                    android:textColor="@color/heliboard_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Navigation Arrow D-Pad -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1.2"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnDpadUp"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_bento_pill_dark"
                    android:padding="8dp"
                    android:src="@drawable/ic_chevron_up"
                    app:tint="@color/heliboard_text" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnDpadLeft"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_bento_pill_dark"
                        android:padding="8dp"
                        android:src="@drawable/ic_arrow_left"
                        app:tint="@color/heliboard_text" />

                    <ImageButton
                        android:id="@+id/btnDpadRight"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="24dp"
                        android:background="@drawable/bg_bento_pill_dark"
                        android:padding="8dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/heliboard_text" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnDpadDown"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_bento_pill_dark"
                    android:padding="8dp"
                    android:rotation="180"
                    android:src="@drawable/ic_chevron_up"
                    app:tint="@color/heliboard_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

    <!-- Overlay Circle Key Highlight / Preview Popup Layer -->
    <FrameLayout
        android:id="@+id/keyPreviewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Material You Balloon Speech Bubble Preview -->
        <com.example.barcodekeyboard.ui.keyboard.MaterialKeyBalloonView
            android:id="@+id/materialKeyBalloonView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <!-- Material You Long-Press MoreKeys Pill Sub-Menu -->
        <com.example.barcodekeyboard.ui.keyboard.MoreKeysPillPopupView
            android:id="@+id/moreKeysPillPopupView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

        <!-- Legacy preview bubble (fallback) -->
        <FrameLayout
            android:id="@+id/keyPreviewBubble"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="top|start"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone"
            android:elevation="12dp">

            <TextView
                android:id="@+id/tvKeyPreviewChar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

    </FrameLayout>

</FrameLayout>
