<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/heliboard_surface"
    android:orientation="vertical">

    <!-- 1. Collapsible Camera Scanner Viewfinder -->
    <FrameLayout
        android:id="@+id/scannerContainer"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:background="#000000"
        android:clipChildren="true"
        android:clipToPadding="false"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreviewView"
            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:layout_gravity="bottom"
            app:implementationMode="compatible" />

        <com.example.barcodekeyboard.ui.keyboard.ScannerOverlayView
            android:id="@+id/scannerOverlayView"
            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:layout_gravity="bottom" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:background="#AA000000"
            android:paddingStart="12dp"
            android:paddingTop="3dp"
            android:paddingEnd="12dp"
            android:paddingBottom="3dp"
            android:text="Arahkan kamera ke barcode/QR"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnGrantPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_key_accent"
            android:text="@string/grant_camera_permission"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 2. HeliBoard-Inspired Top Action Toolbar -->
    <LinearLayout
        android:id="@+id/toolbarContainer"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@color/heliboard_toolbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- Barcode Scanner Toggle Button -->
        <ImageButton
            android:id="@+id/btnToggleScanner"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_toolbar_item"
            android:contentDescription="Toggle Scanner"
            android:padding="6dp"
            android:src="@drawable/ic_scan"
            app:tint="@color/heliboard_accent" />

        <!-- Flashlight Button (visible when scanner active) -->
        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_toolbar_item"
            android:contentDescription="Flashlight"
            android:padding="7dp"
            android:src="@drawable/ic_flash"
            android:visibility="gone"
            app:tint="@color/heliboard_text" />

        <!-- Clipboard History Button -->
        <ImageButton
            android:id="@+id/btnClipboard"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_toolbar_item"
            android:contentDescription="Papan Klip"
            android:padding="7dp"
            android:src="@drawable/ic_clipboard"
            app:tint="@color/heliboard_accent" />

        <!-- Clipboard Paste Button -->
        <ImageButton
            android:id="@+id/btnPaste"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_toolbar_item"
            android:contentDescription="Paste"
            android:padding="7dp"
            android:src="@drawable/ic_paste"
            app:tint="@color/heliboard_text" />

        <!-- Move Cursor Left -->
        <ImageButton
            android:id="@+id/btnCursorLeft"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_toolbar_item"
            android:contentDescription="Cursor Left"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/heliboard_text_sub" />

        <!-- Move Cursor Right -->
        <ImageButton
            android:id="@+id/btnCursorRight"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_toolbar_item"
            android:contentDescription="Cursor Right"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/heliboard_text_sub" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Settings Shortcut -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_toolbar_item"
            android:contentDescription="Settings"
            android:padding="7dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/heliboard_text_sub" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/heliboard_divider" />

    <!-- 3. HeliBoard Essential Keyboard Keypad Area -->
    <LinearLayout
        android:id="@+id/keypadContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="3dp"
        android:paddingTop="5dp"
        android:paddingEnd="3dp"
        android:paddingBottom="6dp">

        <!-- Number Row (1 - 0) -->
        <LinearLayout
            android:id="@+id/rowNumber"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal" />

        <!-- Row 1 -->
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <!-- Row 2 -->
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <!-- Row 3 -->
        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

        <!-- Row 4 -->
        <LinearLayout
            android:id="@+id/row4"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

    </LinearLayout>

    <!-- 4. Clipboard History Panel (Papan Klip) -->
    <LinearLayout
        android:id="@+id/clipboardContainer"
        android:layout_width="match_parent"
        android:layout_height="225dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_clipboard"
                app:tint="@color/heliboard_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Papan Klip"
                android:textColor="@color/heliboard_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClipboardCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:textColor="@color/heliboard_text_sub"
                android:textSize="12sp"
                android:text="(0)" />

            <Button
                android:id="@+id/btnClearClipboard"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Bersihkan"
                android:textColor="#FF5252"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnCloseClipboard"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_toolbar_item"
                android:contentDescription="Tutup Papan Klip"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                app:tint="@color/heliboard_text" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/heliboard_divider" />

        <!-- Recycler View List of Clips -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvClipboardItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:scrollbars="vertical" />

        <!-- Empty State Notice -->
        <TextView
            android:id="@+id/tvClipboardEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="20dp"
            android:text="Papan klip kosong.\nTeks yang Anda salin (copy) akan otomatis muncul di sini."
            android:textAlignment="center"
            android:textColor="@color/heliboard_text_sub"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
