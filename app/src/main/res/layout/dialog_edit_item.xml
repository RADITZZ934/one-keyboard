<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nama Produk / Item:"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etDialogItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="cth: KERANJANG CINCIN KECIL"
        android:inputType="textCapCharacters"
        android:maxLines="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Kode Barcode:"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etDialogItemCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:hint="cth: 5800238"
        android:inputType="number"
        android:maxLines="1"
        android:textColor="@color/heliboard_accent"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Satuan (UOM):"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etDialogItemUom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="cth: PCS, PACK, KG"
        android:inputType="textCapCharacters"
        android:maxLines="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

</LinearLayout>
