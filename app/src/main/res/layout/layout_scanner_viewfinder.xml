<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scannerContainer"
    android:layout_width="match_parent"
    android:layout_height="175dp"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.barcodekeyboard.ui.keyboard.ScannerOverlayView
        android:id="@+id/scannerOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating Quick Torch Button in Viewfinder -->
    <ImageButton
        android:id="@+id/btnViewfinderFlash"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_bento_pill_dark"
        android:contentDescription="Senter"
        android:padding="7dp"
        android:src="@drawable/ic_flash"
        app:tint="#FFFFFF" />

    <!-- Floating Quick Zoom Button (1x / 2x) -->
    <TextView
        android:id="@+id/btnQuickZoom"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_bento_pill_dark"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="1.0x"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Dynamic Camera Focus & HUD Guidance Status Banner -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bento_pill_dark"
        android:elevation="2dp"
        android:paddingStart="14dp"
        android:paddingTop="5dp"
        android:paddingEnd="14dp"
        android:paddingBottom="5dp"
        android:text="Ketuk layar untuk fokus • 2x zoom"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <Button
        android:id="@+id/btnGrantPermission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_key_accent"
        android:text="@string/grant_camera_permission"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

</FrameLayout>
