<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bento_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <!-- 1. Header Section (Minimalist Style from Reference Image) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_bento_matte_black"
                    android:padding="8dp"
                    android:src="@drawable/ic_scan" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="One Keyboard"
                        android:textColor="@color/bento_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Barcode &amp; QR IME"
                        android:textColor="@color/bento_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Activation Status Badge -->
                <TextView
                    android:id="@+id/tvHomeActivationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bento_pill_cream"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Cek Status..."
                    android:textColor="@color/bento_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Title & Subtitle ("Home / Dashboard" typography from mockup) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:text="Home"
                android:textColor="@color/bento_text_primary"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Dashboard"
                android:textColor="@color/bento_text_secondary"
                android:textSize="15sp" />

            <!-- Activation Alert Card (If keyboard not active) -->
            <LinearLayout
                android:id="@+id/cardActivationAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_bento_pill_blue"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="One Keyboard belum aktif • Ketuk untuk aktifkan"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_forward" />
            </LinearLayout>

            <!-- 2. GRID ITEM 1: TEST FIELD CARD (Hitam Doff / Matte Black) -->
            <LinearLayout
                android:id="@+id/cardTestField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_bento_matte_black"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header of Test Field Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_bento_pill_dark"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="TEST FIELD"
                        android:textColor="@color/bento_blue"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnHomeClearInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_bento_pill_dark"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="Hapus"
                        android:textColor="@color/bento_text_sub_dark"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Uji Coba Masukan"
                    android:textColor="@color/bento_text_white"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ketuk kolom di bawah untuk memunculkan One Keyboard dan menguji pemindaian barcode langsung."
                    android:textColor="@color/bento_text_sub_dark"
                    android:textSize="12sp" />

                <!-- Input Box -->
                <EditText
                    android:id="@+id/etHomeTestInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_bento_input_dark"
                    android:hint="Ketik atau pindai barcode di sini..."
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:padding="14dp"
                    android:textColor="@color/bento_text_white"
                    android:textColorHint="@color/bento_text_sub_dark"
                    android:textCursorDrawable="@drawable/cursor_drawable"
                    android:textSize="14sp" />

                <!-- Quick Sound Test Pill Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnHomeTestSuccess"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bento_pill_dark"
                        android:gravity="center"
                        android:text="✓ Tes Beep Sukses"
                        android:textColor="#00E676"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnHomeTestFailure"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bento_pill_dark"
                        android:gravity="center"
                        android:text="✕ Tes Beep Gagal"
                        android:textColor="#FF5252"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- 3. GRID ITEM 2: SCAN HISTORY CARD (Putih / White Card) -->
            <LinearLayout
                android:id="@+id/cardScanHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_bento_white"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header of Scan History Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_bento_pill_blue"
                        android:padding="6dp"
                        android:src="@drawable/ic_history" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Scan History"
                        android:textColor="@color/bento_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvHistoryCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="(0)"
                        android:textColor="@color/bento_text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnHomeClearHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_bento_pill_cream"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="Hapus Semua"
                        android:textColor="@color/bento_text_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layoutEmptyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_bento_pill_cream"
                        android:padding="12dp"
                        android:src="@drawable/qrcode_scan" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Belum Ada Riwayat Pindai"
                        android:textColor="@color/bento_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="Setiap barcode atau kode QR yang Anda pindai lewat One Keyboard akan tercatat di sini."
                        android:textColor="@color/bento_text_muted"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- History RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvScanHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 4. GRID ITEM 3: BUTTON SETTING (Cream Bento Card Redirecting to Settings Page) -->
            <LinearLayout
                android:id="@+id/btnGoToSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_bento_cream"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_bento_matte_black"
                    android:padding="11dp"
                    android:src="@drawable/ic_settings" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Pengaturan"
                        android:textColor="@color/bento_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tema • Pengaturan Scanner • Info Aplikasi"
                        android:textColor="@color/bento_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_bento_pill_blue"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_forward" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
