<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <!-- Description -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sesuaikan tinggi keyboard agar pas dengan ukuran layar dan kenyamanan jemari Anda."
        android:textColor="@color/bento_text_secondary"
        android:textSize="12sp" />

    <!-- Scale Display Card (Live percentage indicator) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_bento_input_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvDialogScalePercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="100%"
            android:textColor="@color/bento_blue"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvDialogScaleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ukuran Standar"
            android:textColor="@color/bento_text_sub_dark"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- SeekBar Slider (80% to 130%) -->
    <SeekBar
        android:id="@+id/sbKeyboardScale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:max="50"
        android:progress="20"
        android:splitTrack="false" />

    <!-- Min / Max Labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="80% (Pendek)"
            android:textColor="@color/bento_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100% (Default)"
            android:textColor="@color/bento_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="130% (Tinggi)"
            android:textColor="@color/bento_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Quick Presets -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:text="Pilihan Cepat:"
        android:textColor="@color/bento_text_primary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPresetShort"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="85%"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPresetNormal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="100%"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPresetTall"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="115%"
            android:textAllCaps="false"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Dedicated Reset Button -->
    <Button
        android:id="@+id/btnResetScale"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_reset"
        app:iconGravity="textStart"
        app:iconSize="16dp"
        app:iconTint="@color/bento_blue"
        android:text="Reset ke Ukuran Standar (100%)"
        android:textAllCaps="false"
        android:textColor="@color/bento_blue"
        android:textSize="13sp" />

</LinearLayout>
